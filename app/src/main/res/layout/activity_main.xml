<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Top Clean Chrome Navigation Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <ImageButton
            android:id="@+id/btnHomeNav"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_today"
            app:tint="#202124"
            android:contentDescription="Home"/>

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/stat_notify_sync"
            app:tint="#202124"
            android:contentDescription="Refresh"/>

        <!-- URL / Search Bar -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/search_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#5F6368" />

            <EditText
                android:id="@+id/etSearchUrl"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Search Google or type URL"
                android:imeOptions="actionSearch"
                android:inputType="textUri"
                android:paddingStart="8dp"
                android:textColor="#202124"
                android:textColorHint="#5F6368"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Tab Counter Button -->
        <TextView
            android:id="@+id/btnTabCounter"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:gravity="center"
            android:text="1"
            android:textColor="#3C4043"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 3-Dot Menu Button -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_more"
            app:tint="#202124"
            android:contentDescription="Menu"/>
    </LinearLayout>

    <!-- Main Container -->
    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar">

        <!-- Home View UI -->
        <ScrollView
            android:id="@+id/homeView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="#FAFBFD">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Modern Stylish Branding -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="20dp"
                    android:text="Ice ❄️ Cool"
                    android:textColor="#1A73E8"
                    android:textSize="38sp"
                    android:textStyle="bold" />

                <!-- Search Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginBottom="25dp"
                    android:background="@drawable/search_bg"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="#4285F4" />

                    <EditText
                        android:id="@+id/etHomeSearch"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Search Google or type URL"
                        android:imeOptions="actionSearch"
                        android:inputType="textUri"
                        android:paddingStart="12dp"
                        android:textColor="#202124"
                        android:textColorHint="#70757A"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Horizontal Shortcuts Bar (Single Line) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:weightSum="5"
                    android:layout_marginTop="10dp">

                    <Button
                        android:id="@+id/btnYoutube"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:backgroundTint="#F1F3F4"
                        android:text="YT"
                        android:textColor="#202124"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnInstagram"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:backgroundTint="#F1F3F4"
                        android:text="IG"
                        android:textColor="#202124"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnFacebook"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:backgroundTint="#F1F3F4"
                        android:text="FB"
                        android:textColor="#202124"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnTwitter"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:backgroundTint="#F1F3F4"
                        android:text="X"
                        android:textColor="#202124"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnWhatsapp"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:backgroundTint="#F1F3F4"
                        android:text="WA"
                        android:textColor="#202124"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

</RelativeLayout>
