<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- Top Chrome Navigation Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <ImageButton
            android:id="@+id/btnHomeNav"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_today"
            android:contentDescription="Home"/>

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/stat_notify_sync"
            android:contentDescription="Refresh"/>

        <!-- Search / URL Bar -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="#F1F3F4"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#5F6368" />

            <EditText
                android:id="@+id/etSearchUrl"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Search Google or type URL"
                android:imeOptions="actionSearch"
                android:inputType="textUri"
                android:paddingStart="8dp"
                android:textColor="#202124"
                android:textColorHint="#5F6368"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Tab Counter Button -->
        <TextView
            android:id="@+id/btnTabCounter"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:gravity="center"
            android:text="1"
            android:textColor="#3C4043"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 3-Dot Menu Button -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_more"
            android:contentDescription="Menu"/>
    </LinearLayout>

    <!-- Main Container (Home View or WebView Container) -->
    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar">

        <!-- Home View UI -->
        <ScrollView
            android:id="@+id/homeView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="20dp"
                    android:text="Google"
                    android:textColor="#4285F4"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <!-- 5 Short Cuts -->
                <GridLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:layout_marginTop="20dp">

                    <Button
                        android:id="@+id/btnYoutube"
                        android:layout_width="95dp"
                        android:layout_height="50dp"
                        android:layout_margin="6dp"
                        android:backgroundTint="#FFFFFF"
                        android:elevation="1dp"
                        android:text="YouTube"
                        android:textColor="#202124"
                        android:textSize="11sp"/>

                    <Button
                        android:id="@+id/btnInstagram"
                        android:layout_width="95dp"
                        android:layout_height="50dp"
                        android:layout_margin="6dp"
                        android:backgroundTint="#FFFFFF"
                        android:elevation="1dp"
                        android:text="Instagram"
                        android:textColor="#202124"
                        android:textSize="11sp"/>

                    <Button
                        android:id="@+id/btnFacebook"
                        android:layout_width="95dp"
                        android:layout_height="50dp"
                        android:layout_margin="6dp"
                        android:backgroundTint="#FFFFFF"
                        android:elevation="1dp"
                        android:text="Facebook"
                        android:textColor="#202124"
                        android:textSize="11sp"/>

                    <Button
                        android:id="@+id/btnTwitter"
                        android:layout_width="95dp"
                        android:layout_height="50dp"
                        android:layout_margin="6dp"
                        android:backgroundTint="#FFFFFF"
                        android:elevation="1dp"
                        android:text="Twitter"
                        android:textColor="#202124"
                        android:textSize="11sp"/>

                    <Button
                        android:id="@+id/btnWhatsapp"
                        android:layout_width="95dp"
                        android:layout_height="50dp"
                        android:layout_margin="6dp"
                        android:backgroundTint="#FFFFFF"
                        android:elevation="1dp"
                        android:text="WhatsApp"
                        android:textColor="#202124"
                        android:textSize="11sp"/>
                </GridLayout>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

</RelativeLayout>
